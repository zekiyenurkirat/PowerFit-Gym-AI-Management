@model WebApplication1.Models.Antrenor

@{
    ViewData["Title"] = "Sil";
}

<h1>Sil</h1>

<h3>Bu antrenörü silmek istediğinize emin misiniz?</h3>
<div>
    <h4>Antrenör Bilgileri</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Ad
        </dt>
        <dd class="col-sm-10">
            @Model.Ad
        </dd>

        <dt class="col-sm-2">
            Soyad
        </dt>
        <dd class="col-sm-10">
            @Model.Soyad
        </dd>

        <dt class="col-sm-2">
            Uzmanlık Alanı
        </dt>
        <dd class="col-sm-10">
            @Model.UzmanlikAlani
        </dd>

        <dt class="col-sm-2">
            Başlangıç Saati
        </dt>
        <dd class="col-sm-10">
            @Model.BaslangicSaati
        </dd>

        <dt class="col-sm-2">
            Bitiş Saati
        </dt>
        <dd class="col-sm-10">
            @Model.BitisSaati
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Evet, Sil" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Listeye Geri Dön</a>
    </form>
</div>
