@model WebApplication1.Models.Antrenor

@{
    ViewData["Title"] = "Antrenör Düzenle";
}

<h2>Antrenör Düzenle</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Ad" class="control-label">Ad</label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Soyad" class="control-label">Soyad</label>
                <input asp-for="Soyad" class="form-control" />
                <span asp-validation-for="Soyad" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="UzmanlikAlani" class="control-label">Uzmanlık Alanı</label>
                <input asp-for="UzmanlikAlani" class="form-control" />
                <span asp-validation-for="UzmanlikAlani" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BaslangicSaati" class="control-label">Başlangıç Saati</label>
                <input asp-for="BaslangicSaati" type="time" class="form-control" />
                <span asp-validation-for="BaslangicSaati" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BitisSaati" class="control-label">Bitiş Saati</label>
                <input asp-for="BitisSaati" type="time" class="form-control" />
                <span asp-validation-for="BitisSaati" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Spor Salonu</label>
                <select asp-for="SporSalonuId" class="form-control" asp-items="@(new SelectList(ViewBag.SporSalonlari, "Id", "Ad"))"></select>
                <span asp-validation-for="SporSalonuId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>
