@model WebApplication1.Models.Randevu

<h2>Randevu Al</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Antrenör</label>
        <select asp-for="AntrenorId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Antrenorler, "Id", "Ad"))">
            <option value="">Antrenör Seç</option>
        </select>
        <span asp-validation-for="AntrenorId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Hizmet</label>
        <select asp-for="HizmetId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Hizmetler, "Id", "Ad"))">
            <option value="">Hizmet Seç</option>
        </select>
        <span asp-validation-for="HizmetId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Tarih</label>
        <input asp-for="TarihSaat" type="datetime-local" class="form-control" />
        <span asp-validation-for="TarihSaat" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Randevu Al</button>
</form>
