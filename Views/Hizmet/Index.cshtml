@model IEnumerable<WebApplication1.Models.Hizmet>

@{
    ViewData["Title"] = "Hizmetlerimiz";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-warning fw-bold"><i class="fa fa-dumbbell"></i> Hizmet Listesi</h1>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa fa-plus"></i> Yeni Hizmet Ekle
            </a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="py-3 px-4">Hizmet Adı</th>
                        <th class="py-3">Süre (Dk)</th>
                        <th class="py-3">Ücret (TL)</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="py-3 text-end px-4">İşlemler</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 py-3 fw-bold text-dark">@item.Ad</td>

                            <td class="py-3">@item.SureDakika</td>

                            <td class="py-3">@item.Ucret</td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-end px-4 py-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark fw-bold">
                                        <i class="fa fa-edit"></i> Düzenle
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger text-white">
                                        <i class="fa fa-trash"></i> Sil
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>